# Zerqon Spider — örnek yapılandırma
# Bu dosyayı `.env` olarak kopyalayıp düzenleyin. `.env` Git'e eklenmez.

# Yerel yönetim sunucusu (varsayılan yalnızca bu bilgisayar)
ZERQON_HOST=127.0.0.1
ZERQON_PORT=8765

# Veri dizini (veritabanı, loglar, raporlar, yedekler). Boşsa proje kökündeki ./data kullanılır.
ZERQON_DATA_DIR=

# Varsayılan arayüz dili: tr | en
ZERQON_DEFAULT_LANGUAGE=tr

# Log seviyesi: DEBUG | INFO | WARNING | ERROR
ZERQON_LOG_LEVEL=INFO

# Localhost modu: yerel geliştirme sitelerini (127.0.0.1 / ::1) taramaya izin verir.
# true olsa bile her taramada ayrıca "localhost'a izin ver" seçeneği işaretlenmelidir.
# Özel ağlar (10.x, 192.168.x ...) ve bulut metadata adresleri her durumda engellidir.
ZERQON_ALLOW_LOCALHOST=false

# Kaynak sınırları (tüm taramalar için üst limitler)
ZERQON_MAX_CONCURRENCY=20
ZERQON_MAX_URLS_HARD_LIMIT=500000
ZERQON_MAX_BODY_BYTES=5242880
ZERQON_RENDER_TIMEOUT_SECONDS=20
ZERQON_MAX_RENDER_CONTEXTS=3
